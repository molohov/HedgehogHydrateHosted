# PostgreSQL connection string
DATABASE_URL="postgresql://hedgehog:hedgehog@localhost:5432/hedgehog_hydrate?schema=public"

# Session signing secret (generate a long random string for production)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Initial admin account (created once on first seed if no admin exists)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-before-deploy"

# Public app URL (used for cookie security in production)
APP_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"
